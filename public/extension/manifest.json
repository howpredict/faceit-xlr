{
  "manifest_version": 3,
  "name": "FACEIT XLR v2",
  "version": "2.2",
  "description": "Make your game a little more enjoyable.",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "action": {
    "default_title": "FACEIT XLR",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.faceit.com/*",
        "https://faceit.com/*"
      ],
      "js": [
        "shared.js",
        "colors.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "wallpaper.html"
      ],
      "matches": [
        "https://www.faceit.com/*",
        "https://faceit.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; img-src 'self' blob: data:; media-src 'self' blob:; connect-src https://*.faceit-cdn.net https://*.faceit.com; frame-src 'self';"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://*.faceit-cdn.net/*",
    "https://*.faceit.com/*"
  ],
  "version_name": "2.2"
}
